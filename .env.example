# Dhanvantri Clinic - Digital Queue Management System
# Environment Configuration Template
# Copy this file to .env and fill in the values. Never commit .env to version control.

# Frontend Public Variables (React / Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLINIC_PHONE=
VITE_APP_URL=

# Backend / Supabase Edge Functions & Scripts (Keep Secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Optional Notification Providers (SMS / WhatsApp)
# MSG91 Integration (Default for Indian SMS)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=

# Twilio Integration (Fallback / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
